{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // scripts/*.mjs are run by hand and by the workflows (`node scripts/<name>.mjs`, or a docker run), and test/*.test.mjs by `node --test test/` (CI's test job); nothing imports them.
  "entry": ["scripts/*.mjs", "test/*.test.mjs"],
  // The seal and drand dependencies are listed in tools/package.json (`npm ci --prefix tools`), not in the root one Knip reads.
  "ignoreDependencies": ["tlock-js", "sigstore"]
}
